# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnpm-store
.pnpm-debug.log*

# Testing
/coverage
/test-fixtures

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build
/dist

# Environment Variables
# IMPORTANT: Never commit real credentials
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel
.vercel.json

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs and editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Misc
*.log
.cache
.turbo

# Phase Results (internal documentation)
.phase1-results/
.phase2-results/

# Lock files (keep pnpm-lock.yaml for reproducible builds)
package-lock.json
yarn.lock
