/// ============================================================================
/// POLICY ANALYSIS MODELS - Added 2025-11-16
/// ============================================================================
/// Stores structured data extracted from policy PDF artifacts
/// Source: PLAN_ANALISIS_POLIZAS_PDF.md Section 6.1.2
model PolicyAnalysis {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactId        String                @map("artifact_id") @db.Uuid
  caseId            String                @map("case_id") @db.Uuid
  orgId             String                @map("org_id") @db.Uuid
  extractedData     Json                  @map("extracted_data")
  extractionMethod  String                @default("hybrid") @map("extraction_method")
  overallConfidence Decimal               @default(0.00) @map("overall_confidence") @db.Decimal(3, 2)
  extractedAt       DateTime              @default(now()) @map("extracted_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  complianceRecords ComplianceRecord[]
  artifact          Artifact              @relation(fields: [artifactId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_policy_analyses_artifact")
  case              Case                  @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_policy_analyses_case")
  organizations     organizations         @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_policy_analyses_org")
  pageReferences    PolicyPageReference[]
  renewals          Renewal[]

  @@index([artifactId], map: "idx_policy_analyses_artifact_id")
  @@index([caseId], map: "idx_policy_analyses_case_id")
  @@index([overallConfidence], map: "idx_policy_analyses_confidence")
  @@index([extractedAt(sort: Desc)], map: "idx_policy_analyses_extracted_at")
  @@index([extractedData], map: "idx_policy_analyses_extracted_data", type: Gin)
  @@index([orgId], map: "idx_policy_analyses_org_id")
  @@map("policy_analyses")
  @@schema("public")
}

/// Maps extracted policy fields to their exact locations in the source PDF
model PolicyPageReference {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyAnalysisId String         @map("policy_analysis_id") @db.Uuid
  fieldName        String         @map("field_name")
  fieldValue       String?        @map("field_value")
  pageNumber       Int            @map("page_number")
  boundingBox      Json?          @map("bounding_box")
  confidence       Decimal        @default(0.00) @db.Decimal(3, 2)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  policyAnalysis   PolicyAnalysis @relation(fields: [policyAnalysisId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_policy_page_refs_analysis")

  @@index([policyAnalysisId], map: "idx_policy_page_refs_analysis_id")
  @@index([confidence], map: "idx_policy_page_refs_confidence")
  @@index([fieldName], map: "idx_policy_page_refs_field_name")
  @@index([pageNumber], map: "idx_policy_page_refs_page_number")
  @@map("policy_page_references")
  @@schema("public")
}

/// ============================================================================
/// COMPARISON MODELS - Added FASE 30
