model Case {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String?          @map("org_id") @db.Uuid
  clientRef          String?          @map("client_ref") @db.VarChar(255)
  clientName         String?          @map("client_name") @db.VarChar(255)
  businessType       String?          @map("business_type") @db.VarChar(255)
  employees          Int?
  status             String           @default("draft") @db.VarChar(50)
  stage              String           @default("initial") @db.VarChar(50)
  briefData          Json?            @map("brief_data")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  priority           String           @default("medium") @db.VarChar(20)
  budget_currency    String?          @default("COP") @map("budget_currency") @db.VarChar(3)
  client_profile     String?          @map("client_profile")
  insurance_category String?
  max_budget         Decimal?         @map("max_budget") @db.Decimal(10, 2)
  required_coverages String[]         @default([]) @map("required_coverages")
  artifacts          Artifact[]
  auditLogs          AuditLog[]
  messages           Message[]
  policyAnalyses     PolicyAnalysis[] // ✅ NUEVO: Relación con análisis de pólizas
  comparisons        Comparison[] // ✅ FASE 30: Relación con comparaciones
  renewals           Renewal[]    // ✅ FASE RENOVACIONES: Relación con renovaciones
  complianceRecords  ComplianceRecord[] // ✅ FASE COMPLIANCE: Registros de cumplimiento

  @@map("cases")
  @@schema("public")
}

model Artifact {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String           @map("case_id") @db.Uuid
  sourceType     SourceType       @map("source_type")
  fileId         String?          @map("file_id") @db.VarChar(255)
  fileName       String?          @map("file_name") @db.VarChar(255)
  contentType    String?          @map("content_type") @db.VarChar(100)
  contentText    String?          @map("content_text")
  provenance     Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  policyAnalyses PolicyAnalysis[] // ✅ NUEVO: Relación con análisis de pólizas

  @@map("artifacts")
  @@schema("public")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId       String?  @map("case_id") @db.Uuid // ✅ Opcional: NULL para eventos de clients u otros recursos sin caso
  orgId        String?  @map("org_id") @db.Uuid // ✅ SINCRONIZADO: Columna existente en BD
  userId       String?  @map("user_id") @db.Uuid // ✅ SINCRONIZADO: Columna existente en BD
  actor        String   @db.VarChar(255)
  action       String   @db.VarChar(100)
  tool         String?  @db.VarChar(50)
  resourceType String?  @map("resource_type") @db.VarChar(50) // ✅ SINCRONIZADO: 'case', 'artifact', 'client', etc.
  resourceId   String?  @map("resource_id") @db.Uuid // ✅ SINCRONIZADO: ID del recurso afectado
  severity     String?  @db.VarChar(20) // ✅ SINCRONIZADO: 'info', 'warning', 'error', 'critical'
  ipAddress    String?  @map("ip_address") @db.VarChar(45) // ✅ SINCRONIZADO: IPv4/IPv6
  userAgent    String?  @map("user_agent") // ✅ SINCRONIZADO: User agent del navegador
  payloadHash  String?  @map("payload_hash") @db.VarChar(64)
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  case         Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade) // ✅ Opcional: NULL para eventos sin caso

  @@index([orgId], map: "idx_audit_log_org_id")
  @@index([userId], map: "idx_audit_log_user_id")
  @@index([resourceType], map: "idx_audit_log_resource_type")
  @@index([createdAt(sort: Desc)], map: "idx_audit_log_created_at")
  @@map("audit_log")
  @@schema("public")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  role      String
  content   Bytes // ✅ Encriptado usando pgcrypto (BYTEA). Usar encrypt_pii()/decrypt_pii()
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([createdAt])
  @@index([role])
  @@map("messages")
  @@schema("public")
}

