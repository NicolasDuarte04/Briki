/// ============================================================================
/// MODELOS LEGACY NEXTAUTH - ELIMINADOS 2025-12-31
/// ============================================================================
/// Los siguientes modelos fueron eliminados porque:
/// 1. Las tablas en BD estaban vacías (0 registros)
/// 2. La autenticación se maneja completamente con Supabase Auth
/// 3. No había código que los referenciara
///
/// Modelos eliminados:
/// - Account (reemplazado por auth.identities)
/// - Session (reemplazado por auth.sessions)
/// - VerificationToken (manejado por Supabase Auth)
/// - public_User (reemplazado por auth.users)
/// - public_Profile (reemplazado por public.profiles)
///
/// Migración SQL: 20251231_remove_nextauth_legacy_tables_final.sql
/// ============================================================================

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model oauth_authorizations {
  id                    String                     @id @db.Uuid
  authorization_id      String                     @unique
  client_id             String                     @db.Uuid
