  userId         String?          @map("user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  renewal        Renewal          @relation(fields: [renewalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([renewalId], map: "idx_renewal_alerts_renewal_id")
  @@index([sentAt], map: "idx_renewal_alerts_sent_at")
  @@index([alertType], map: "idx_renewal_alerts_type")
  @@index([userId], map: "idx_renewal_alerts_user_id")
  @@map("renewal_alerts")
  @@schema("public")
}

