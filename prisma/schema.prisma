model Case {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String?             @map("org_id") @db.Uuid
  clientRef           String?             @map("client_ref") @db.VarChar(255)
  clientName          String?             @map("client_name") @db.VarChar(255)
  businessType        String?             @map("business_type") @db.VarChar(255)
  employees           Int?
  status              String              @default("draft") @db.VarChar(50)
  stage               String              @default("initial") @db.VarChar(50)
  briefData           Json?               @map("brief_data")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  priority            String              @default("medium") @db.VarChar(20)
  budget_currency     String?             @default("COP") @map("budget_currency") @db.VarChar(3)
  client_profile      String?             @map("client_profile")
  insurance_category  String?
  max_budget          Decimal?            @map("max_budget") @db.Decimal(10, 2)
  required_coverages  String[]            @default([]) @map("required_coverages")
  artifacts           Artifact[]
  auditLogs           AuditLog[]
  comparisons         Comparison[]
  complianceRecords   ComplianceRecord[]
  generated_proposals GeneratedProposal[]
  messages            Message[]
  policyAnalyses      PolicyAnalysis[]
  renewals            Renewal[]

  @@map("cases")
  @@schema("public")
}

model Artifact {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String           @map("case_id") @db.Uuid
  sourceType     SourceType       @map("source_type")
  fileId         String?          @map("file_id") @db.VarChar(255)
  fileName       String?          @map("file_name") @db.VarChar(255)
  contentType    String?          @map("content_type") @db.VarChar(100)
  contentText    String?          @map("content_text")
  provenance     Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  policyAnalyses PolicyAnalysis[]

  @@map("artifacts")
  @@schema("public")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId        String?  @map("case_id") @db.Uuid
  actor         String   @db.VarChar(255)
  action        String   @db.VarChar(100)
  tool          String?  @db.VarChar(50)
  payloadHash   String?  @map("payload_hash") @db.VarChar(64)
  payload       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  org_id        String?  @db.Uuid
  user_id       String?  @db.Uuid
  resource_type String?
  resource_id   String?  @db.Uuid
  severity      String?  @default("info")
  ip_address    String?  @db.Inet
  user_agent    String?
  case          Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("audit_log")
  @@schema("public")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  role      String
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  content   Bytes?
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([createdAt])
  @@index([role])
  @@map("messages")
  @@schema("public")
}

